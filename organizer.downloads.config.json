{
  "watchRoot": "/mnt/c/Users/wlsdn/Downloads",
  "organizedRoot": "/mnt/c/Users/wlsdn/Downloads/_organized_by_agent",
  "scanIntervalMs": 5000,
  "settleMs": 4000,
  "dryRun": false,
  "logEachMove": false,
