      ".jpg": "images",
      ".jpeg": "images",
      ".png": "images",
      ".gif": "images",
      ".webp": "images",
      ".svg": "images",
      ".mp4": "videos",
      ".mov": "videos",
      ".avi": "videos",
      ".mkv": "videos",
      ".mp3": "audio",
      ".wav": "audio",
      ".pdf": "documents/pdf",
      ".doc": "documents/office",
      ".docx": "documents/office",
      ".ppt": "documents/office",
      ".pptx": "documents/office",
      ".xls": "documents/office",
      ".xlsx": "documents/office",
      ".csv": "data",
      ".json": "data",
      ".txt": "documents/text",
      ".md": "documents/text",
      ".zip": "archives",
      ".rar": "archives",
      ".7z": "archives",
      ".tar": "archives",
      ".gz": "archives",
      ".exe": "installers",
      ".msi": "installers",
      ".apk": "installers",
